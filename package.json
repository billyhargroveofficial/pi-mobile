{
  "name": "billy-pi-mobile",
  "version": "0.6.008",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "test": "node --import ./scripts/host-runtime.mjs --test --test-concurrency=2 tests/*.test.mjs",
    "check:architecture": "node tools/check-architecture.mjs",
    "check:ui-baseline": "node tools/check-ui-baseline.mjs",
    "quality": "npm test && npm run check:architecture && npm run check:ui-baseline"
  },
  "dependencies": {
    "ws": "8.21.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./extension/mobile.ts"
    ]
  },
  "engines": {
    "node": ">=22.18"
  }
}
