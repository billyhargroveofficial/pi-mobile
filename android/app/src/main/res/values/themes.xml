<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Pi" />
    <style name="Theme.PiMobile" parent="Theme.PiMobile.Base" />
    <style name="Theme.PiMobile.Base" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="materialButtonStyle">@style/Pi.Button</item>
        <item name="buttonBarPositiveButtonStyle">@style/Pi.Button.Tiny</item>
        <item name="buttonBarNegativeButtonStyle">@style/Pi.Button.Tiny</item>
        <item name="buttonBarNeutralButtonStyle">@style/Pi.Button.Tiny</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_soft</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_soft</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_soft</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_alt</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_soft</item>
        <item name="colorError">@color/danger</item>
        <item name="colorErrorContainer">@color/danger_soft</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Pi.SectionTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Pi.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Pi.Input">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:minHeight">56dp</item>
    </style>
    <style name="Pi.Shape.Button" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">24dp</item></style>
    <style name="Pi.Button" parent="Widget.Material3Expressive.Button">
        <item name="shapeAppearance">@style/Pi.Shape.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
    </style>
    <style name="Pi.Button.Primary" parent="Pi.Button" />
    <style name="Pi.Button.Secondary" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="shapeAppearance">@style/Pi.Shape.Button</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Pi.Button.Danger" parent="Pi.Button.Secondary">
        <item name="backgroundTint">@color/danger_soft</item>
        <item name="android:textColor">@color/danger</item>
        <item name="iconTint">@color/danger</item>
    </style>
    <style name="Pi.Button.Tiny" parent="Widget.Material3Expressive.Button.TextButton">
        <item name="shapeAppearance">@style/Pi.Shape.Button</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Pi.Shape.Circle" parent="">
        <item name="cornerFamily">rounded</item><item name="cornerSize">50%</item>
    </style>
    <style name="Pi.Icon" parent="Widget.Material3Expressive.Button.IconButton.Tonal">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item><item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item><item name="android:paddingStart">0dp</item><item name="android:paddingEnd">0dp</item>
        <item name="iconPadding">0dp</item><item name="iconSize">24dp</item>
        <item name="iconGravity">textStart</item><item name="android:gravity">center</item>
        <item name="shapeAppearance">@style/Pi.Shape.Circle</item>
        <item name="shapeAppearanceOverlay">@style/Pi.Shape.Circle</item>
    </style>
    <style name="Pi.Segment" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:textSize">11sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="backgroundTint">@color/segment_background</item>
        <item name="icon">@null</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Pi.Badge">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>
</resources>
