<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="12dp" android:paddingBottom="6dp" android:orientation="horizontal" android:gravity="center_vertical" android:accessibilityHeading="true">
