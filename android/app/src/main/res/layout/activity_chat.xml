<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/chatRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:orientation="vertical">
    <LinearLayout android:id="@+id/chatTopBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingVertical="6dp" android:orientation="horizontal" android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/backButton" style="@style/Pi.Icon" android:layout_width="48dp" android:layout_height="48dp" app:icon="@drawable/ic_back" android:contentDescription="@string/cd_back_button"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/chatTitleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                <View android:id="@+id/chatConnectionDot" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/circle_dot" android:backgroundTint="@color/dot_idle"/>
                <TextView android:id="@+id/chatStatusText" style="@style/Pi.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:maxLines="1" android:ellipsize="end" android:contentDescription="@string/cd_connection_status"/>
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/stopButton" style="@style/Pi.Icon" android:layout_width="48dp" android:layout_height="48dp" app:icon="@drawable/ic_stop" app:iconTint="@color/danger" app:backgroundTint="@color/danger_soft" android:contentDescription="@string/cd_stop_button"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/thinkingStrip" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="24dp" android:visibility="gone">
        <com.google.android.material.loadingindicator.LoadingIndicator android:layout_width="36dp" android:layout_height="36dp" android:importantForAccessibility="no"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Pi работает над задачей" android:textSize="12sp" android:textColor="@color/accent" android:accessibilityLiveRegion="polite"/>
    </LinearLayout>
    <TextView android:id="@+id/truncatedBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:background="@drawable/bg_badge_warn" android:padding="12dp" android:text="@string/truncated_banner" android:textColor="@color/on_secondary_soft" android:textSize="12sp" android:visibility="gone"/>
    <TextView android:id="@+id/readOnlyBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:background="@drawable/bg_badge_warn" android:padding="12dp" android:text="@string/read_only_banner" android:textColor="@color/on_secondary_soft" android:textSize="12sp" android:visibility="gone"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/historyProgress" style="@style/Pi.Button.Tiny" android:layout_width="match_parent" android:layout_height="48dp" android:text="↑ Ранее" android:visibility="gone"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/messageList" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="12dp" android:paddingBottom="16dp" android:scrollbars="none" android:contentDescription="@string/cd_message_list"/>
        <TextView android:id="@+id/chatEmptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:padding="36dp" android:gravity="center" android:text="Нет сообщений" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_secondary" android:visibility="gone"/>
    </FrameLayout>
    <LinearLayout android:id="@+id/composerContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginBottom="8dp" android:padding="10dp" android:background="@drawable/bg_card" android:orientation="vertical">
        <TextView android:id="@+id/attachmentsTitle" style="@style/Pi.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:text="@string/attachments_title" android:visibility="gone"/>
        <HorizontalScrollView android:id="@+id/attachmentsScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:visibility="gone">
            <LinearLayout android:id="@+id/attachmentStrip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
        </HorizontalScrollView>
        <EditText android:id="@+id/composerInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:padding="8dp" android:background="@android:color/transparent" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="17sp" android:hint="Что сделаем?" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences" android:imeOptions="flagNoEnterAction" android:importantForAutofill="no" android:maxLines="5" android:minLines="1" android:contentDescription="@string/cd_composer_input"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/attachImageButton" style="@style/Pi.Icon" android:layout_width="48dp" android:layout_height="48dp" app:icon="@drawable/ic_add" app:backgroundTint="@color/surface_alt" app:iconTint="@color/text_primary" android:contentDescription="@string/cd_attach_button"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/modelButton" style="@style/Pi.Button.Tiny" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:paddingHorizontal="6dp" android:minWidth="0dp" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:text="Модель ▾" android:contentDescription="Модель и effort"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/behaviorMenuButton" style="@style/Pi.Button.Tiny" android:layout_width="88dp" android:layout_height="48dp" android:minWidth="0dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:textSize="11sp" android:text="Очередь ▾" android:maxLines="1" android:contentDescription="Режим отправки"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/sendButton" style="@style/Pi.Icon" android:layout_width="48dp" android:layout_height="48dp" app:icon="@drawable/ic_send" app:backgroundTint="@color/send_background" app:iconTint="@color/send_foreground" android:contentDescription="@string/cd_send_button"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
