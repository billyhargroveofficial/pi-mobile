    ],
    "voice": [
      "ui/DictationRecorder"
    ],
    "updater": [
      "ui/AppUpdates"
    ]
  },
  "sourceContracts": {
    "features/orchestration/OrchestrationSession": "platform-free-state",
    "features/orchestration/OrchestrationProjection": "pure-projection",
    "features/orchestration/OrchestrationScreen": "presentation-only",
    "features/chat/ChatHeader": "presentation-only",
    "features/chat/ChatWorkDock": "presentation-only",
    "features/chat/ChatScreen": "presentation-only",
    "features/chat/ChatComposer": "presentation-only",
    "features/catalog/UsageProjection": "pure-projection",
    "features/catalog/UsageSession": "platform-free-state",
    "features/catalog/UsageScreen": "presentation-only",
    "features/catalog/ArchiveProjection": "pure-projection",
    "features/catalog/ArchiveSession": "platform-free-state",
    "features/catalog/ArchiveScreen": "presentation-only",
    "features/chat/ModelCapabilities": "pure-projection",
    "features/chat/ModelSettingsSession": "platform-free-state",
    "features/chat/QuickEffortSession": "platform-free-state",
    "features/chat/ModelSettingsScreen": "presentation-only",
    "features/chat/QuickEffortScreen": "presentation-only"
  },
  "platformInteropDependencies": {
    "ui/ImageViewer": [
      "PiApp"
    ],
    "ui/ArchiveSheet": [
      "PiApp"
    ]
  },
  "platformClasses": {
    "core": [
      "Ack",
      "AckParser",
      "Catalog",
      "CatalogParser",
      "CatalogRow",
      "ChatMessage",
      "CommandBuilder",
      "ConnectionState",
      "ConversationFrames",
      "DurationText",
