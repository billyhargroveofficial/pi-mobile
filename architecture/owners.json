      "features/catalog/UsageSession",
      "features/catalog/UsageScreen",
      "features/catalog/ArchiveProjection",
      "features/catalog/ArchiveSession",
      "features/catalog/ArchiveScreen"
    ],
    "chat": [
      "ChatActivity",
      "features/chat/ChatOutbox",
      "features/chat/ChatSession",
      "features/chat/ChatScreen",
      "ui/EffortPopup",
      "ui/EffortSlider",
      "ui/ImageViewer",
      "ui/MarkdownPreview",
      "ui/MarkdownRenderer",
      "ui/ModelSettingsSheet",
      "ui/TierToggle",
      "ui/PiTranscript",
      "features/chat/ChatHeader",
      "features/chat/ChatComposer",
      "features/chat/ChatWorkDock",
      "features/chat/ModelCapabilities",
      "features/chat/ModelSettingsSession",
      "features/chat/QuickEffortSession",
      "features/chat/ModelSettingsScreen",
      "features/chat/QuickEffortScreen"
    ],
    "orchestration": [
      "OrchestrationActivity",
      "ui/OrchestrationEntry",
      "features/orchestration/OrchestrationSession",
      "features/orchestration/OrchestrationProjection",
      "features/orchestration/OrchestrationScreen"
    ],
    "voice": [
      "ui/DictationRecorder",
      "ui/VoiceWaveform"
    ],
    "updater": [
      "ui/AppUpdates"
    ],
    "ui-foundation": [
      "ui/BubbleColors",
      "ui/ExpressiveMotion",
      "ui/SwipeAction",
      "ui/SystemInsets",
      "ui/PiTheme",
      "ui/ComposeSheet",
      "ui/PiIcons",
      "ui/StatusUi",
      "ui/PiIconButton"
    ]
  },
  "compositionRoots": [
    "PiApp",
    "MainActivity",
    "ChatActivity",
    "OrchestrationActivity"
  ],
  "publicFeatureApis": {
    "catalog": [
      "MainActivity"
    ],
    "chat": [
      "ChatActivity",
      "ui/PiTranscript"
    ],
    "orchestration": [
      "OrchestrationActivity",
